# .env にコピーして値を設定する。.env は Git に入れない（.gitignore 済み）。
# 秘密情報は PC と NAS のバックアップにのみ保存する。

OPEN_WEBUI_VERSION=
N8N_VERSION=

# Tailscale の MagicDNS 名（例: ms02-ultra / tailXXXX.ts.net）
TS_HOSTNAME=
TS_TAILNET=

# 新規生成: powershell -c "[Convert]::ToBase64String((1..48|%{[byte](Get-Random -Max 256)}))"
WEBUI_SECRET_KEY=

# ★ 既存 n8n の config（または既存 .env）にある encryptionKey をそのまま入れる
N8N_ENCRYPTION_KEY=

# Strata が OpenAI 互換 API を持つ場合のみ
STRATA_OPENAI_COMPAT=false
STRATA_API_BASE_URL=
STRATA_API_KEY=

# NAS 上の n8n 専用フォルダ（新規作成するサブフォルダ）
NAS_N8N_DIR=
